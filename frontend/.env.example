# Variables de entorno de ejemplo para el frontend
# Cópialo como .env.development o .env.production según corresponda
# y ajusta la URL según tu backend.

# Desarrollo local: usa el proxy de Vite hacia http://localhost:5000
# VITE_API_URL=/api

# Producción Render: apunta directamente a tu API deployada
# VITE_API_URL=https://biblioteca-personal-50ou.onrender.com/api

# Base path para GitHub Pages (dejar comentado si usas el workflow de Actions)
# Si tu repo se llama "biblioteca", el valor sería:
# VITE_BASE_PATH=/biblioteca/
# Para desarrollo local o dominio personalizado, dejar ./ o /
